<UserControl x:Class="ShelfTalker.OneLLabel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Height="533" Width="1028">
    <Grid Name="Grid">
        <TextBlock Height="186" Margin="10,10,10,0" Name="Description" Text="Product Name 1234567890" TextTrimming="CharacterEllipsis" FontFamily="Arial" FontSize="40" HorizontalAlignment="Center" Width="1008" TextAlignment="Center" FontWeight="Bold" TextWrapping="WrapWithOverflow" VerticalAlignment="Top" />
        <TextBlock FontFamily="Arial" FontSize="18" Margin="10,161,10,337" Name="OurPriceText" Text="" TextTrimming="CharacterEllipsis" Height="35" HorizontalAlignment="Center" Width="1008" VerticalAlignment="Center" TextAlignment="Center" FontWeight="Bold" />
        <TextBlock FontFamily="Arial" FontSize="250" Margin="10,161,10,119" Name="OurPriceAmount" Text="$250.99" TextTrimming="CharacterEllipsis" Height="253" HorizontalAlignment="Center" Width="1008" VerticalAlignment="Center" TextAlignment="Center" FontWeight="Bold" />
        <TextBlock FontFamily="Arial" FontSize="40" Margin="10,473,10,10" Name="WhyPay" Text="Why pay $300.00" TextTrimming="CharacterEllipsis" Foreground="Black" HorizontalAlignment="Center" TextAlignment="Left" Width="1008" FontWeight="Bold" />
        <TextBlock FontFamily="Arial" FontSize="10" Margin="956,489,10,10" Name="CatalogueDate" Text="Cat 01/01/33" TextTrimming="CharacterEllipsis" Foreground="Black" HorizontalAlignment="Center" TextAlignment="Left" Width="62" FontWeight="Bold" />
        <Border BorderBrush="Black" BorderThickness="0" HorizontalAlignment="Left" Height="533" VerticalAlignment="Top" Width="1028"/>
    </Grid>
</UserControl>
